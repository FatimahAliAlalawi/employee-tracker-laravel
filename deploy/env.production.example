# ملف .env لسيرفر المعهد (قاعدة MySQL الخاصة بـ XAMPP على نفس الجهاز)
# انسخه إلى جذر المشروع باسم .env ثم شغّل: php artisan key:generate

APP_NAME="متابعة"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# الرابط الذي يفتحه الموظفون (يجب أن يكون HTTPS حتى يعمل تسجيل الحضور بالـ GPS)
APP_URL=https://tracker.alrowad.edu.sa

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
TRACKER_TIMEZONE=Asia/Riyadh
TRACKER_TABLE_PREFIX=
TRACKER_TRUSTED_PROXY_HEADER=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# ---- قاعدة XAMPP على نفس السيرفر ----
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=employee_tracker
# مستخدم خاص بالنظام (لا تستخدم root) — أنشئه من phpMyAdmin ← User accounts
DB_USERNAME=tracker_app
# اكتب كلمة المرور بنفسك هنا
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=720
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# بريد المعهد (SMTP)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@alrowad.edu.sa"
MAIL_FROM_NAME="${APP_NAME}"
