APP_NAME="متابعة"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

# توقيت النظام (بديل توقيت ووردبريس) — كل حسابات الحضور والتأخير بهذا التوقيت
TRACKER_TIMEZONE=Asia/Riyadh
# بادئة الجداول: اتركها فارغة لتثبيت جديد، أو ضع wp_ إذا استوردت جداول ووردبريس كما هي
TRACKER_TABLE_PREFIX=
# خلف Cloudflare: HTTP_CF_CONNECTING_IP
TRACKER_TRUSTED_PROXY_HEADER=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=employee_tracker
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=720
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# (اختياري) اتصال بقاعدة ووردبريس القديمة لاستيراد البيانات: php artisan tracker:import-wordpress
WP_DB_HOST=127.0.0.1
WP_DB_PORT=3306
WP_DB_DATABASE=
WP_DB_USERNAME=
WP_DB_PASSWORD=
WP_DB_PREFIX=wp_
